<div class="h-full w-full flex flex-col items-center justify-center space-y-6">
  <h1 class="font-title text-4xl text-zinc-300 font-semibold">Tour #<%= @tour.id %></h1>

  <%= render "tours/board", tour: @tour, wrapper_class: "max-w-2xl rounded-2xl overflow-hidden" %>

  <div class="flex items-center gap-3">
    <p class="text-zinc-400"><%= pluralize(@tour.moves.size, "move") %></p>
    <%= render "tours/status_pill", tour: @tour %>
  </div>
</div>
