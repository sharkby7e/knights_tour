#!/usr/bin/env sh
# Runs before `git push`. Blocks the push if RuboCop or the JS tests fail.
# Enabled via: git config core.hooksPath .githooks

echo "Running RuboCop before push..."
bin/rubocop
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "RuboCop failed. Fix offenses (bin/rubocop -a for autocorrect) or"
  echo "skip this hook with 'git push --no-verify' if you really need to."
  exit 1
fi

echo "Running bin/jstest before push..."
bin/jstest
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "JS tests failed. Fix them or skip this hook with"
  echo "'git push --no-verify' if you really need to."
  exit 1
fi

exit 0
