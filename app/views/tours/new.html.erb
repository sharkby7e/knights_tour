<div class="h-full w-full flex flex-col items-center justify-center space-y-6 touch-manipulation" data-controller="tour">
  <div class="flex flex-col lg:flex-row gap-x-10 gap-y-6 items-center">
    <div class="flex flex-col items-center gap-2">
      <div id="board" class="grid grid-rows-8 grid-cols-8 shrink-0 rounded-lg overflow-hidden shadow-lg">
        <% Square.all.each do |square| %>
          <% dark = (square.x + square.y).odd? %>
          <div id="<%= square.dom_id %>"
               class="w-12 h-12 lg:w-28 lg:h-28 flex items-center justify-center border border-gray-500 transition-colors duration-200 ease-out <%= dark ? "bg-board-dark" : "bg-board-light" %>"
               data-tour-target="square"
               data-square-notation="<%= square.notation %>"
               data-action="click->tour#move"></div>
        <% end %>
      </div>
    </div>

    <div class="flex flex-col space-y-3 items-center">
      <p data-tour-target="status" class="h-10 flex items-center justify-center text-lg text-zinc-300 whitespace-nowrap overflow-hidden">Choose a starting square</p>

      <div class="w-64 flex flex-col items-center gap-2">
        <span class="text-xs uppercase tracking-wide text-zinc-500">Visited Squares</span>
        <%= render "tours/move_ticker", target_prefix: "tour" %>
      </div>

      <div class="flex gap-4">
        <button type="button" data-tour-target="undoButton" data-action="click->tour#undo" disabled
                title="Undo"
                class="bg-zinc-700 hover:bg-zinc-600 disabled:opacity-40 disabled:hover:bg-zinc-700 text-zinc-200 w-12 h-12 flex items-center justify-center rounded-lg transition-colors duration-200 cursor-pointer disabled:cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
          </svg>
          <span class="sr-only">Undo</span>
        </button>
        <button type="button" data-action="click->tour#restart"
                title="Restart"
                class="bg-accent hover:bg-accent-hover text-white w-12 h-12 flex items-center justify-center rounded-lg transition-colors duration-200 cursor-pointer">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99"/>
          </svg>
          <span class="sr-only">Restart</span>
        </button>
        <button type="button" data-tour-target="saveButton" data-action="click->tour#save" disabled
                title="Save"
                class="bg-zinc-700 hover:bg-zinc-600 disabled:opacity-40 disabled:hover:bg-zinc-700 text-zinc-200 w-12 h-12 flex items-center justify-center rounded-lg transition-colors duration-200 cursor-pointer disabled:cursor-not-allowed">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25v9.75a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5V6A1.5 1.5 0 0 1 6 4.5h9.75L19.5 8.25Z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 4.5v3.75a.75.75 0 0 1-.75.75H8.25a.75.75 0 0 1-.75-.75V4.5" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 19.5v-6a.75.75 0 0 1 .75-.75h6a.75.75 0 0 1 .75.75v6" />
          </svg>
          <span class="sr-only">Save</span>
        </button>
      </div>
    </div>
  </div>
</div>
