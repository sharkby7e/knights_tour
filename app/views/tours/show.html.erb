<div class="h-full w-full flex flex-col items-center justify-center gap-6 py-4"
     data-controller="tour-playback"
     data-tour-playback-moves-value="<%= @tour.moves.pluck(:square).to_json %>"
     data-action="keydown@window->tour-playback#keydown">

  <%= link_to tours_path, class: "self-start -mb-2 flex items-center gap-1 text-sm text-zinc-400 hover:text-zinc-200 transition-colors duration-150" do %>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 18l-6-6 6-6"/></svg>
    All tours
  <% end %>

  <div class="flex items-center gap-3">
    <h1 class="font-title text-2xl text-zinc-300 font-semibold">Tour #<%= @tour.id %></h1>
    <%= render "tours/status_pill", tour: @tour %>
  </div>

  <div class="flex flex-col lg:flex-row gap-8 items-center lg:items-start">
    <div class="relative grid grid-rows-8 grid-cols-8 aspect-square w-80 lg:w-[48rem] rounded-2xl overflow-hidden shadow-lg">
      <% Square.all.each do |square| %>
        <div data-tour-playback-target="square"
             class="flex items-center justify-center border border-gray-500 transition-colors duration-200 ease-out"></div>
      <% end %>
      <svg viewBox="0 0 100 100" class="absolute inset-0 w-full h-full pointer-events-none" data-tour-playback-target="pathSvg"></svg>
    </div>

    <div class="w-full max-w-sm flex flex-col gap-5">
      <div class="flex items-baseline justify-between">
        <span data-tour-playback-target="notation" class="font-title text-2xl text-board-current tabular-nums">&mdash;</span>
        <span class="text-sm text-zinc-400 tabular-nums">
          <span data-tour-playback-target="stepNum">0</span> / <span data-tour-playback-target="stepTotal"><%= @tour.moves.size %></span>
        </span>
      </div>

      <input type="range" class="scrubber" min="0" max="<%= @tour.moves.size %>" value="<%= @tour.moves.size %>" step="1"
             data-tour-playback-target="scrubber" data-action="input->tour-playback#scrub" aria-label="Move scrubber">

      <div class="transport">
        <button type="button" title="Jump to start" aria-label="Jump to start"
                data-tour-playback-target="startButton" data-action="click->tour-playback#toStart">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 4v16"/><path d="M18 6 8 12l10 6V6Z"/></svg>
        </button>
        <button type="button" title="Previous move" aria-label="Previous move"
                data-tour-playback-target="prevButton" data-action="click->tour-playback#prev">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="play" title="Play" aria-label="Play"
                data-tour-playback-target="playButton" data-action="click->tour-playback#togglePlay">
          <svg data-tour-playback-target="playIcon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <svg data-tour-playback-target="pauseIcon" viewBox="0 0 24 24" fill="currentColor" class="hidden"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
        </button>
        <button type="button" title="Next move" aria-label="Next move"
                data-tour-playback-target="nextButton" data-action="click->tour-playback#next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
        </button>
        <button type="button" title="Jump to end" aria-label="Jump to end"
                data-tour-playback-target="endButton" data-action="click->tour-playback#toEnd">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 4v16"/><path d="M6 6l10 6-10 6V6Z"/></svg>
        </button>
      </div>

      <%= render "tours/move_ticker", target_prefix: "tour-playback" %>

      <div class="flex items-center justify-between gap-3">
        <span class="text-xs uppercase tracking-wide text-zinc-500">Speed</span>
        <div class="speed-group">
          <button type="button" class="speed-btn" data-ms="900" data-tour-playback-target="speedButton" data-action="click->tour-playback#setSpeed">0.5&times;</button>
          <button type="button" class="speed-btn active" data-ms="450" data-tour-playback-target="speedButton" data-action="click->tour-playback#setSpeed">1&times;</button>
          <button type="button" class="speed-btn" data-ms="180" data-tour-playback-target="speedButton" data-action="click->tour-playback#setSpeed">2&times;</button>
          <button type="button" class="speed-btn" data-ms="70" data-tour-playback-target="speedButton" data-action="click->tour-playback#setSpeed">4&times;</button>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3">
        <span class="text-xs uppercase tracking-wide text-zinc-500">Show path line</span>
        <button type="button" class="toggle on" aria-label="Toggle path line" aria-pressed="true"
                data-tour-playback-target="pathToggle" data-action="click->tour-playback#togglePath"></button>
      </div>
    </div>
  </div>
</div>
