<%
  stuck = game.stuck?
  current = square == game.current_square
  visited = game.visited?(square)
  legal = !stuck && game.legal_moves_from.include?(square)
  dark = (square.x + square.y).odd?

  bg_class =
    if stuck
      "bg-zinc-700"
    elsif current
      "bg-[#e0cf9c]"
    elsif visited
      "bg-red-400"
    elsif dark
      "bg-slate-500"
    else
      "bg-slate-100"
    end
%>
<div id="<%= square.dom_id %>" class="w-10 h-10 sm:w-24 sm:h-24 flex items-center justify-center text-3xl sm:text-5xl border border-gray-400 <%= bg_class %>" data-turbo-prefetch="false">
  <%= link_to_if legal, "", tour_moves_path(game.tour, square: square.notation),
        class: "w-full h-full bg-emerald-400", data: { turbo_method: :post, turbo_prefetch: false } do %>
    <% if current %>♞<% end %>
  <% end %>
</div>
