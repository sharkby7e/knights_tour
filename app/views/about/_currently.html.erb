<section class="py-8 pb-16" data-about="currently">
  <div class="bg-zinc-700/80 border border-accent/40 rounded-2xl px-8 py-9 text-center">
    <span class="block font-mono text-xs tracking-widest uppercase text-accent mb-3">right now</span>
    <h2 class="font-title font-semibold text-xl text-zinc-200 mb-3">Looking for my next role</h2>
    <p class="text-zinc-400 leading-relaxed max-w-md mx-auto mb-7">
      A line or two on what you're looking for — role, focus area, what kind of team excites you.
      Specific beats vague here.
    </p>
    <div class="flex gap-3 justify-center flex-wrap">
      <%= link_to "Email me", "mailto:sgquin@gmail.com", class: "text-sm font-semibold px-6 py-2.5 rounded-lg bg-accent text-zinc-950 hover:bg-accent-hover transition-colors duration-150" %>
      <%= link_to "LinkedIn", "#", class: "text-sm font-semibold px-6 py-2.5 rounded-lg border border-zinc-600 text-zinc-200 hover:border-zinc-400 transition-colors duration-150" %>
      <%= link_to "Résumé", "#", class: "text-sm font-semibold px-6 py-2.5 rounded-lg border border-zinc-600 text-zinc-200 hover:border-zinc-400 transition-colors duration-150" %>
    </div>
  </div>
</section>
