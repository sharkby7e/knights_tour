<% content_for :description, "Play the Knight's Tour puzzle on a chessboard — solve it, save your run, and replay it move by move." %>

<div class="h-full w-full flex flex-col items-center justify-center touch-manipulation"
     data-controller="tour"
     data-action="keydown@window->tour#keydown">
  <div class="flex flex-col lg:flex-row gap-y-3 lg:gap-x-16 items-center">
    <div id="board" class="relative grid grid-rows-8 grid-cols-8 aspect-square w-[min(90vw,24rem)] lg:w-[56rem] shrink-0 rounded-lg overflow-hidden shadow-lg">
      <% Square.all.each do |square| %>
        <% dark = (square.x + square.y).odd? %>
        <div id="<%= square.dom_id %>"
             class="flex items-center justify-center border border-gray-500 transition-colors duration-200 ease-out <%= dark ? "bg-board-dark" : "bg-board-light" %>"
             data-tour-target="square"
             data-square-notation="<%= square.notation %>"
             data-action="click->tour#move"></div>
      <% end %>
      <svg viewBox="0 0 100 100" class="absolute inset-0 w-full h-full pointer-events-none" data-tour-target="pathSvg"></svg>
    </div>

    <% top_slot = capture do %>
      <p data-tour-target="status" class="lg:text-center text-lg lg:text-2xl text-zinc-300 whitespace-nowrap lg:whitespace-normal overflow-hidden">Choose a starting square</p>
    <% end %>

    <% controls_row = capture do %>
      <div class="transport">
        <button type="button" title="Undo" aria-label="Undo"
                data-tour-target="prevButton" data-action="click->tour#prev"
                class="flex-col gap-0.5 w-14 h-12 lg:w-16 lg:h-14">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          <span data-tour-target="controlLabel" class="text-[9px] uppercase tracking-wide">Undo</span>
        </button>
        <button type="button" title="Restart" aria-label="Restart"
                data-action="click->tour#restart"
                class="flex-col gap-0.5 w-14 h-12 lg:w-16 lg:h-14">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"/>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
          </svg>
          <span data-tour-target="controlLabel" class="text-[9px] uppercase tracking-wide">Restart</span>
        </button>
        <button type="button" title="Save" aria-label="Save"
                data-tour-target="saveButton" data-action="click->tour#save"
                class="flex-col gap-0.5 w-14 h-12 lg:w-16 lg:h-14">
          <%= render "tours/save_icon" %>
          <span data-tour-target="controlLabel" class="text-[9px] uppercase tracking-wide">Save</span>
        </button>
      </div>
    <% end %>

    <%= render layout: "tours/controls_column", locals: { target_prefix: "tour", top_slot: top_slot, controls: controls_row, show_ticker: false } do %>
      <div class="flex items-center justify-between gap-3">
        <span class="text-xs uppercase tracking-wide text-zinc-500 flex items-center gap-1.5">
          Warnsdorff Helper
          <button type="button" data-action="click->tour#openHintInfo" aria-label="What's this?"
                  class="w-4 h-4 rounded-full border border-zinc-500 text-zinc-500 hover:text-zinc-300 hover:border-zinc-300 text-[10px] leading-none flex items-center justify-center cursor-pointer">?</button>
        </span>
        <button type="button" class="toggle" aria-label="Toggle Warnsdorff Helper" aria-pressed="false"
                data-tour-target="moveCountToggle" data-action="click->tour#toggleMoveCounts"></button>
      </div>
    <% end %>
  </div>

  <dialog data-tour-target="saveDialog" class="modal bg-zinc-900 text-zinc-200 border border-zinc-700 rounded-lg p-6 w-80 max-w-[90vw]">
    <form data-action="submit->tour#confirmSave" class="flex flex-col gap-4">
      <h2 class="text-lg font-semibold text-zinc-100">Name your tour</h2>
      <input type="text" data-tour-target="nameInput" placeholder="Optional"
             class="bg-zinc-800 border border-zinc-700 rounded-md px-3 py-2 text-base text-zinc-100 placeholder:text-zinc-500 focus:outline-none focus:border-accent">
      <p data-tour-target="saveError" class="hidden text-sm text-red-400">Couldn't save — try again.</p>
      <div class="flex justify-end gap-2">
        <button type="button" data-action="click->tour#cancelSave"
                class="px-3 py-1.5 rounded-md text-sm text-zinc-300 hover:bg-zinc-800 cursor-pointer">Cancel</button>
        <button type="submit"
                class="px-3 py-1.5 rounded-md text-sm font-medium bg-accent hover:bg-accent-hover text-zinc-950 cursor-pointer">Save</button>
      </div>
    </form>
  </dialog>

  <dialog data-tour-target="hintDialog" class="modal bg-zinc-900 text-zinc-200 border border-zinc-700 rounded-lg p-6 w-80 lg:w-[28rem] max-w-[90vw]">
    <div class="flex flex-col gap-4">
      <h2 class="text-lg font-semibold text-zinc-100">Warnsdorff's Heuristic</h2>
      <p class="text-sm text-zinc-300">Warnsdorff's Heuristic states that the best move amongst available move options is the the one with the lowest possible options for the next move. <br><br> This helper shows how many moves are available to each of your move options. Choosing the lowest value helps you to avoid getting stuck.</p>
      <div class="flex justify-end">
        <button type="button" data-action="click->tour#closeHintInfo"
                class="px-3 py-1.5 rounded-md text-sm font-medium bg-accent hover:bg-accent-hover text-zinc-950 cursor-pointer">Got it</button>
      </div>
    </div>
  </dialog>
</div>
