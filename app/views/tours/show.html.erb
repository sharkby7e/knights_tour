<div class="h-full w-full flex flex-col items-center justify-center touch-manipulation"
     data-controller="tour-playback"
     data-tour-playback-moves-value="<%= @tour.moves.pluck(:square).to_json %>"
     data-action="keydown@window->tour-playback#keydown">

  <div class="flex flex-col lg:flex-row gap-y-3 lg:gap-x-16 items-center">
    <%= render "tours/playback_board" %>
    <%= render "tours/playback_controls", tour: @tour %>
  </div>
</div>
