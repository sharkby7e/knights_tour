<% complete = tour.moves.size == 64 %>
<li data-tour-id="<%= tour.id %>" class="group bg-zinc-700/60 border border-zinc-600/60 rounded-2xl overflow-hidden hover:border-accent/50 transition-colors duration-200">
  <div class="relative aspect-square w-full">
    <%= render "board_path", tour: tour %>

    <span class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-full text-xs font-semibold text-zinc-950 <%= complete ? "bg-board-legal" : "bg-board-visited" %>">
      <%= complete ? "Complete" : "Stuck" %>
    </span>
  </div>

  <div class="p-4 flex items-center justify-between gap-2">
    <p class="font-title text-zinc-200">Tour #<%= tour.id %></p>
    <p class="text-zinc-400 text-sm whitespace-nowrap"><%= tour.moves.size %> moves &middot; <%= time_ago_in_words(tour.created_at) %> ago</p>
  </div>
</li>
