<div class="w-64 flex flex-col gap-3 lg:gap-6">
  <div class="tour-name h-16 lg:h-24 lg:w-full flex flex-col items-center justify-center gap-1">
    <%= top_slot %>
  </div>

  <%= controls %>

  <% if local_assigns.fetch(:show_ticker, true) %>
    <%= render "tours/ticker_row", target_prefix: target_prefix, total: total %>
  <% end %>

  <div class="<%= "mt-3 lg:mt-0" unless local_assigns.fetch(:show_ticker, true) %>">
    <%= render "tours/path_toggle", target_prefix: target_prefix %>
  </div>

  <%= yield %>
</div>
