<% first_square = tour.moves.first&.to_square %>
<% last_square = tour.moves.last&.to_square %>
<% path_points = tour.moves.map { |m|
      sq = m.to_square
      "#{(sq.x - 0.5) * 12.5},#{(8 - sq.y + 0.5) * 12.5}"
    }.join(" ") %>
<svg viewBox="0 0 100 100" class="w-full h-full block">
  <% Square.all.each do |square| %>
    <% dark = (square.x + square.y).odd? %>
    <rect x="<%= (square.x - 1) * 12.5 %>" y="<%= (8 - square.y) * 12.5 %>" width="12.5" height="12.5"
          class="<%= dark ? "fill-board-dark" : "fill-board-light" %>" />
  <% end %>
  <polyline points="<%= path_points %>"
            fill="none" stroke="#22d3ee" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"
            vector-effect="non-scaling-stroke" />
  <polyline points="<%= path_points %>"
            fill="none" stroke="#ff2ee0" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"
            vector-effect="non-scaling-stroke" class="animate-pulse-line" />
  <% if first_square %>
    <circle cx="<%= (first_square.x - 0.5) * 12.5 %>" cy="<%= (8 - first_square.y + 0.5) * 12.5 %>" r="2.25"
            class="fill-board-legal" />
  <% end %>
  <% if last_square %>
    <circle cx="<%= (last_square.x - 0.5) * 12.5 %>" cy="<%= (8 - last_square.y + 0.5) * 12.5 %>" r="2.25"
            class="fill-board-visited" />
  <% end %>
</svg>
